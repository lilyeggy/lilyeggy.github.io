---
const { title = "lilyeggy's web", description = 'Projects, progress, and notes by lilyeggy.' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <nav class="nav">
        <a class="brand" href="/"><span class="brand-mark">L</span><span>lilyeggy<span class="brand-dot">.</span>web</span></a>
        <div class="nav-links">
          <a href="/">首页</a>
          <a href="#projects">项目</a>
          <a href="#activity">动态</a>
          <a href="https://github.com/lilyeggy" target="_blank" rel="noreferrer">GitHub <span>↗</span></a>
        </div>
      </nav>
      <slot />
      <footer><span>© {new Date().getFullYear()} lilyeggy</span><span>building things, one commit at a time.</span></footer>
    </div>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');

  :root {
    --ink: #172238;
    --muted: #5f6d82;
    --soft: #8793a5;
    --line: #d8e0ea;
    --paper: #f4f6f9;
    --white: #fff;
    --navy: #1d2b4d;
    --navy-muted: #b9c5da;
    --blue: #315fc4;
    --blue-dark: #294aa8;
    --blue-soft: #eaf0fc;
    --coral: #d8614e;
    font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--ink);
    background: var(--paper);
    line-height: 1.6;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--paper); }
  a { color: inherit; text-decoration: none; }
  .site-shell { width: min(1120px, calc(100% - 48px)); margin: 0 auto; }

  .nav { height: 78px; display: flex; align-items: center; justify-content: space-between; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-size: 15px; font-weight: 700; letter-spacing: -.035em; }
  .brand-mark { display: grid; place-items: center; width: 28px; height: 28px; color: #fff; background: var(--ink); border-radius: 5px; font-family: 'DM Mono', monospace; font-size: 13px; }
  .brand-dot { color: var(--coral); }
  .nav-links { display: flex; align-items: center; gap: 25px; color: var(--muted); font-family: 'DM Mono', monospace; font-size: 11px; }
  .nav-links a { padding: 4px 0; }
  .nav-links a:hover { color: var(--blue); }
  .nav-links a:last-child { color: var(--ink); border-bottom: 1px solid var(--ink); }
  .nav-links a:last-child span { color: var(--coral); }

  main { padding: 25px 0 88px; }
  .intro { min-height: 385px; display: flex; flex-direction: column; justify-content: space-between; padding: 38px 44px 29px; color: #fff; background: var(--navy); border-radius: 10px; }
  .intro-top { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; color: var(--blue); font-family: 'DM Mono', monospace; font-size: 10px; font-weight: 500; letter-spacing: .09em; text-transform: uppercase; }
  .eyebrow::before { content: ''; display: inline-block; width: 6px; height: 6px; background: var(--coral); border-radius: 50%; }
  .intro .eyebrow { color: #c1cce0; }
  .availability { padding: 6px 10px; color: #c8e9d8; border: 1px solid #779c8b; border-radius: 4px; font-family: 'DM Mono', monospace; font-size: 10px; }
  .intro-content { margin-top: 40px; }
  .intro h1 { max-width: 700px; margin: 0 0 16px; color: #fff; font-size: clamp(42px, 6vw, 64px); line-height: 1; letter-spacing: -.075em; }
  .intro h1 em { color: #b9c5ff; font-style: normal; }
  .intro-description { max-width: 570px; margin: 0; color: var(--navy-muted); font-size: 16px; line-height: 1.75; }
  .intro-actions { display: flex; gap: 10px; margin-top: 23px; }
  .button { padding: 9px 13px; color: var(--ink); background: #fff; border: 1px solid #fff; border-radius: 4px; font-size: 11px; font-weight: 600; }
  .button.secondary { color: #fff; background: transparent; border-color: #8795b1; }
  .button:hover { opacity: .82; }
  .intro-footer { display: flex; gap: 18px; color: #aab7cf; font-family: 'DM Mono', monospace; font-size: 10px; }
  .intro-footer span + span { padding-left: 18px; border-left: 1px solid #657493; }

  .section-heading { display: flex; align-items: center; gap: 14px; margin: 68px 0 19px; }
  .section-heading h2 { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: .04em; }
  .section-number { color: var(--coral); font-family: 'DM Mono', monospace; font-size: 10px; }
  .section-rule { height: 1px; flex: 1; background: var(--line); }
  .section-note { color: var(--soft); font-family: 'DM Mono', monospace; font-size: 10px; }

  .card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 15px; }
  .card { display: flex; flex-direction: column; min-height: 282px; padding: 21px; background: var(--white); border: 1px solid var(--line); border-radius: 8px; transition: border-color .18s ease, transform .18s ease; }
  .card:hover { border-color: #9eafd1; transform: translateY(-2px); }
  .card.featured { background: #f8f9ff; border-top: 2px solid var(--blue); }
  .card-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .card-index { color: var(--soft); font-family: 'DM Mono', monospace; font-size: 10px; }
  .card-status { color: #287953; font-family: 'DM Mono', monospace; font-size: 9px; letter-spacing: .04em; text-transform: uppercase; }
  .featured .card-status { color: var(--blue); }
  .card h3 { margin: 27px 0 11px; font-size: 23px; line-height: 1.1; letter-spacing: -.06em; }
  .card h3 span { color: var(--blue); }
  .card p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.7; }
  .card-bottom { display: flex; align-items: end; justify-content: space-between; gap: 10px; margin-top: auto; padding-top: 22px; }
  .tech-list { display: flex; flex-wrap: wrap; gap: 5px; }
  .tech-list span { padding: 3px 6px; color: var(--blue-dark, #294aa8); background: var(--blue-soft); border-radius: 3px; font-family: 'DM Mono', monospace; font-size: 9px; }
  .card-link { flex: none; color: var(--blue-dark, #294aa8); font-family: 'DM Mono', monospace; font-size: 10px; }
  .card-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  .daily-card { background: #fffaf7; border-color: #eaded7; }
  .daily-card .card-status, .daily-card .card-link { color: var(--coral); }
  .log-list { margin: 18px 0 0; padding: 0; list-style: none; color: var(--muted); font-family: 'DM Mono', monospace; font-size: 10px; }
  .log-list li { display: flex; gap: 10px; padding: 8px 0; border-top: 1px solid #eee0d8; }
  .log-list time { flex: none; color: var(--coral); }

  .activity-card { display: grid; grid-template-columns: 220px 1fr; gap: 28px; align-items: center; padding: 23px 25px; background: var(--white); border: 1px solid var(--line); border-radius: 8px; }
  .activity-card h3 { margin: 8px 0 5px; font-size: 19px; letter-spacing: -.04em; }
  .activity-card p { margin: 0; color: var(--muted); font-size: 12px; }
  .activity-graph { min-width: 0; overflow: hidden; }
  .activity-graph img { display: block; width: 100%; max-width: 650px; height: auto; }
  .activity-caption { display: flex; justify-content: space-between; margin-top: 7px; color: var(--soft); font-family: 'DM Mono', monospace; font-size: 9px; }

  footer { display: flex; justify-content: space-between; padding: 20px 0 32px; border-top: 1px solid var(--line); color: var(--soft); font-family: 'DM Mono', monospace; font-size: 10px; }

  .prose { max-width: 780px; }
  .prose h1 { color: var(--ink); font-size: clamp(40px, 6vw, 64px); line-height: 1.05; letter-spacing: -.07em; }
  .prose h2 { margin-top: 44px; color: var(--blue-dark, #294aa8); font-size: 23px; }
  .prose p, .prose li { color: var(--muted); }
  .prose code { padding: 3px 6px; color: var(--blue-dark, #294aa8); background: var(--blue-soft); border-radius: 3px; }
  .prose a { color: var(--blue-dark, #294aa8); text-decoration: underline; text-decoration-color: #9eafe8; text-underline-offset: 3px; }

  @media (max-width: 820px) {
    .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .site-shell { width: min(100% - 32px, 1120px); }
    .nav { height: 70px; }
    .nav-links { gap: 12px; }
    .nav-links a:nth-child(1), .nav-links a:nth-child(3) { display: none; }
    main { padding-top: 14px; }
    .intro { min-height: 480px; padding: 26px 24px 24px; border-radius: 8px; }
    .intro-top { align-items: flex-start; flex-direction: column; }
    .intro-content { margin-top: 47px; }
    .intro h1 { font-size: 48px; }
    .intro-description { font-size: 15px; }
    .intro-footer { flex-wrap: wrap; gap: 8px 14px; }
    .intro-footer span + span { padding-left: 14px; }
    .card-grid { grid-template-columns: 1fr; }
    .card { min-height: 270px; }
    .activity-card { grid-template-columns: 1fr; gap: 16px; }
    .activity-graph img { min-width: 550px; transform: scale(.58); transform-origin: left top; margin-bottom: -72px; }
    footer { flex-direction: column; gap: 7px; }
  }
</style>
