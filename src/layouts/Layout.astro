---
const { title = "lilyeggy's web", description = 'Projects, progress, and notes by lilyeggy.' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <nav class="nav">
        <a class="brand" href="/"><span class="brand-mark">L</span><span>lilyeggy<span class="brand-dot">.</span>web</span></a>
        <div class="nav-links">
          <a href="/">首页</a>
          <a href="#projects">项目</a>
          <a href="#activity">动态</a>
          <a class="github-link" href="https://github.com/lilyeggy" target="_blank" rel="noreferrer">GitHub <span>↗</span></a>
        </div>
      </nav>
      <slot />
      <footer><span>© {new Date().getFullYear()} lilyeggy</span><span>building things, one commit at a time.</span></footer>
    </div>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');

  :root {
    --ink: #172238;
    --muted: #69758a;
    --line: #dde3ec;
    --paper: #f3f5f8;
    --white: #ffffff;
    --blue: #4169e1;
    --blue-dark: #294aa8;
    --purple: #8681e8;
    --coral: #ef725b;
    font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--ink);
    background: var(--paper);
    line-height: 1.6;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--paper); }
  a { color: inherit; text-decoration: none; }
  .site-shell { width: min(1120px, calc(100% - 48px)); margin: 0 auto; }

  .nav { height: 82px; display: flex; align-items: center; justify-content: space-between; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-size: 16px; font-weight: 700; letter-spacing: -.04em; }
  .brand-mark { display: grid; place-items: center; width: 30px; height: 30px; color: #fff; background: var(--ink); border-radius: 8px; font-family: 'DM Mono', monospace; font-size: 14px; }
  .brand-dot { color: var(--coral); }
  .nav-links { display: flex; align-items: center; gap: 26px; color: var(--muted); font-family: 'DM Mono', monospace; font-size: 11px; }
  .nav-links a:hover { color: var(--blue); }
  .github-link { color: var(--ink); font-weight: 500; }
  .github-link span { color: var(--coral); font-size: 15px; }

  main { padding: 24px 0 96px; }
  .hero-panel { position: relative; min-height: 485px; overflow: hidden; padding: 48px 54px 40px; color: #fff; background: linear-gradient(126deg, #111a38 0%, #1d2b5c 54%, #39498d 100%); border-radius: 26px; box-shadow: 0 24px 55px rgba(25, 39, 77, .22); }
  .hero-panel::before { content: ''; position: absolute; width: 520px; height: 520px; top: -260px; right: -95px; border: 1px solid rgba(255,255,255,.16); border-radius: 50%; box-shadow: 0 0 0 36px rgba(255,255,255,.025), 0 0 0 72px rgba(255,255,255,.025); }
  .hero-panel::after { content: ''; position: absolute; right: -60px; bottom: -125px; width: 370px; height: 270px; background: #7777e644; filter: blur(38px); transform: rotate(-18deg); }
  .hero-content, .hero-footer { position: relative; z-index: 1; }
  .hero-top { display: flex; align-items: center; justify-content: space-between; gap: 15px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; color: var(--blue); font-family: 'DM Mono', monospace; font-size: 10px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; }
  .eyebrow::before { content: ''; display: inline-block; width: 7px; height: 7px; background: var(--coral); border-radius: 50%; }
  .hero-panel .eyebrow { color: #b9c6ff; }
  .availability { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; color: #c7f5df; border: 1px solid #8ad8b655; border-radius: 99px; background: #0f294366; font-family: 'DM Mono', monospace; font-size: 10px; }
  .availability::before { content: ''; width: 6px; height: 6px; background: #67d99c; border-radius: 50%; box-shadow: 0 0 0 4px #67d99c22; }
  .hero-panel h1 { max-width: 740px; margin: 72px 0 20px; font-size: clamp(48px, 7vw, 82px); line-height: .95; letter-spacing: -.085em; }
  .hero-panel h1 em { color: #bcb9ff; font-style: normal; }
  .hero-panel p { max-width: 580px; margin: 0; color: #c3cde0; font-size: 17px; line-height: 1.75; }
  .hero-actions { display: flex; gap: 11px; margin-top: 28px; }
  .hero-button { padding: 11px 16px; color: var(--ink); background: #fff; border-radius: 6px; font-size: 12px; font-weight: 600; }
  .hero-button.secondary { color: #fff; border: 1px solid #ffffff55; background: #ffffff0d; }
  .hero-button:hover { transform: translateY(-2px); transition: transform .18s ease; }
  .hero-footer { position: absolute; right: 54px; bottom: 38px; left: 54px; display: flex; align-items: center; gap: 18px; color: #aab7d2; font-family: 'DM Mono', monospace; font-size: 10px; }
  .hero-footer span + span { padding-left: 18px; border-left: 1px solid #ffffff2e; }

  .section-heading { display: flex; align-items: center; gap: 15px; margin: 78px 0 20px; }
  .section-heading h2 { margin: 0; font-size: 13px; font-weight: 700; letter-spacing: .02em; }
  .section-number { color: var(--coral); font-family: 'DM Mono', monospace; font-size: 11px; }
  .section-rule { height: 1px; flex: 1; background: var(--line); }
  .section-note { color: var(--muted); font-family: 'DM Mono', monospace; font-size: 10px; }

  .card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 17px; }
  .card { display: flex; flex-direction: column; min-height: 310px; padding: 23px; background: var(--white); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 8px 22px rgba(23, 34, 56, .045); transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
  .card:hover { transform: translateY(-5px); border-color: #aebde4; box-shadow: 0 17px 32px rgba(23, 34, 56, .11); }
  .card.featured { color: #fff; background: linear-gradient(145deg, #1a2750, #283a78); border-color: #263b7d; }
  .card-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .card-index { color: #97a3b7; font-family: 'DM Mono', monospace; font-size: 10px; }
  .featured .card-index { color: #9faed5; }
  .card-icon { display: grid; place-items: center; width: 34px; height: 34px; color: var(--blue); background: #edf1ff; border-radius: 8px; font-family: 'DM Mono', monospace; font-size: 15px; }
  .featured .card-icon { color: #ffcf9f; background: #ffffff18; }
  .card-status { color: #28845f; font-family: 'DM Mono', monospace; font-size: 9px; letter-spacing: .05em; text-transform: uppercase; }
  .featured .card-status { color: #a3ebc5; }
  .card h3 { margin: 27px 0 11px; font-size: 24px; line-height: 1.08; letter-spacing: -.06em; }
  .card h3 span { color: var(--blue); }
  .featured h3 span { color: #c1c0ff; }
  .card p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.75; }
  .featured p { color: #c4cee2; }
  .card-bottom { display: flex; align-items: end; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 24px; }
  .tech-list { display: flex; flex-wrap: wrap; gap: 5px; }
  .tech-list span { padding: 4px 7px; color: var(--blue-dark); background: #edf1ff; border-radius: 4px; font-family: 'DM Mono', monospace; font-size: 9px; }
  .featured .tech-list span { color: #cdd4ff; background: #ffffff17; }
  .card-link { flex: none; color: var(--blue-dark); font-family: 'DM Mono', monospace; font-size: 10px; }
  .featured .card-link { color: #ffd19f; }
  .card-link:hover { text-decoration: underline; text-underline-offset: 4px; }

  .daily-card { background: #fffaf4; border-color: #f1e2d2; }
  .daily-card .card-icon { color: var(--coral); background: #fff0e5; }
  .log-list { margin: 19px 0 0; padding: 0; list-style: none; color: var(--muted); font-family: 'DM Mono', monospace; font-size: 10px; }
  .log-list li { display: flex; gap: 10px; padding: 9px 0; border-top: 1px solid #f0e2d5; }
  .log-list time { flex: none; color: var(--coral); }

  .activity-card { display: grid; grid-template-columns: 225px 1fr; gap: 28px; align-items: center; padding: 24px 26px; background: var(--white); border: 1px solid var(--line); border-radius: 14px; }
  .activity-card h3 { margin: 8px 0 5px; font-size: 20px; letter-spacing: -.045em; }
  .activity-card p { margin: 0; color: var(--muted); font-size: 12px; }
  .activity-graph { min-width: 0; overflow: hidden; }
  .activity-graph img { display: block; width: 100%; max-width: 650px; height: auto; }
  .activity-caption { display: flex; justify-content: space-between; margin-top: 9px; color: var(--muted); font-family: 'DM Mono', monospace; font-size: 9px; }

  footer { display: flex; justify-content: space-between; padding: 22px 0 36px; border-top: 1px solid var(--line); color: var(--muted); font-family: 'DM Mono', monospace; font-size: 10px; }

  .prose { max-width: 780px; }
  .prose h1 { color: var(--ink); font-size: clamp(40px, 6vw, 64px); line-height: 1.05; letter-spacing: -.07em; }
  .prose h2 { margin-top: 44px; color: var(--blue-dark); font-size: 23px; }
  .prose p, .prose li { color: var(--muted); }
  .prose code { padding: 3px 6px; color: var(--blue-dark); background: #e8edff; border-radius: 4px; }
  .prose a { color: var(--blue-dark); text-decoration: underline; text-decoration-color: #9eafe8; text-underline-offset: 3px; }

  @media (max-width: 800px) {
    .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero-panel { padding-right: 38px; padding-left: 38px; }
    .hero-footer { right: 38px; left: 38px; }
  }
  @media (max-width: 600px) {
    .site-shell { width: min(100% - 32px, 1120px); }
    .nav { height: 72px; }
    .nav-links { gap: 12px; }
    .nav-links a:nth-child(1), .nav-links a:nth-child(3) { display: none; }
    main { padding-top: 15px; }
    .hero-panel { min-height: 510px; padding: 28px 24px; border-radius: 20px; }
    .hero-top { align-items: flex-start; flex-direction: column; }
    .hero-panel h1 { margin-top: 67px; font-size: 51px; }
    .hero-panel p { font-size: 15px; }
    .hero-footer { right: 24px; bottom: 28px; left: 24px; flex-wrap: wrap; gap: 10px; }
    .card-grid { grid-template-columns: 1fr; }
    .card { min-height: 285px; }
    .section-heading { margin-top: 60px; }
    .section-note { display: none; }
    .activity-card { grid-template-columns: 1fr; gap: 16px; }
    .activity-graph img { min-width: 550px; transform: scale(.58); transform-origin: left top; margin-bottom: -72px; }
    footer { flex-direction: column; gap: 7px; }
  }
</style>
