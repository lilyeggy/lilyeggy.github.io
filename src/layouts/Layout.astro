---
const { title = "lilyeggy's web", description = 'Projects, progress, and notes by lilyeggy.' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <nav class="nav">
        <a class="brand" href="/"><span class="brand-mark">L</span><span>lilyeggy<span class="brand-dot">.</span>web</span></a>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="#projects">Projects</a>
          <a href="#activity">Activity</a>
          <a class="github-link" href="https://github.com/lilyeggy" target="_blank" rel="noreferrer">GitHub <span>↗</span></a>
        </div>
      </nav>
      <slot />
      <footer><span>© {new Date().getFullYear()} lilyeggy</span><span>made with curiosity &amp; too much coffee</span></footer>
    </div>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');

  :root {
    --ink: #172338;
    --muted: #63718a;
    --line: #dce3ed;
    --paper: #f5f7fb;
    --white: #ffffff;
    --blue: #2f63da;
    --blue-dark: #204ba9;
    --lavender: #eeedff;
    --coral: #ed6a52;
    font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--ink);
    background: var(--paper);
    line-height: 1.6;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--paper); }
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: .45;
    background-image: linear-gradient(rgba(47, 99, 218, .035) 1px, transparent 1px), linear-gradient(90deg, rgba(47, 99, 218, .035) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  a { color: inherit; text-decoration: none; }
  .site-shell { width: min(1120px, calc(100% - 48px)); margin: 0 auto; position: relative; }

  .nav { height: 86px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-size: 16px; font-weight: 700; letter-spacing: -.03em; }
  .brand-mark { display: grid; place-items: center; width: 30px; height: 30px; color: #fff; background: var(--ink); border-radius: 7px; font-family: 'DM Mono', monospace; font-size: 14px; }
  .brand-dot { color: var(--coral); }
  .nav-links { display: flex; align-items: center; gap: 25px; color: var(--muted); font-family: 'DM Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: .03em; }
  .nav-links a { transition: color .18s ease; }
  .nav-links a:hover { color: var(--blue); }
  .github-link { color: var(--ink); border-bottom: 1px solid var(--ink); padding-bottom: 2px; }
  .github-link span { color: var(--coral); font-size: 14px; }

  main { padding: 86px 0 110px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; color: var(--blue); font-family: 'DM Mono', monospace; font-size: 11px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; }
  .eyebrow::before { content: ''; display: inline-block; width: 7px; height: 7px; background: var(--coral); border-radius: 50%; }
  .hero { max-width: 820px; }
  .hero h1 { max-width: 760px; margin: 18px 0 20px; color: var(--ink); font-size: clamp(43px, 7vw, 78px); line-height: .98; letter-spacing: -.075em; }
  .hero h1 em { color: var(--blue); font-style: normal; }
  .hero p { max-width: 640px; margin: 0; color: var(--muted); font-size: 18px; line-height: 1.75; }
  .hero-meta { display: flex; align-items: center; gap: 16px; margin-top: 30px; color: var(--muted); font-family: 'DM Mono', monospace; font-size: 11px; }
  .status { display: inline-flex; align-items: center; gap: 7px; color: #23835d; }
  .status::before { content: ''; width: 7px; height: 7px; background: #36b77b; border-radius: 50%; box-shadow: 0 0 0 4px #36b77b1f; }
  .meta-divider { width: 1px; height: 14px; background: var(--line); }

  .section-heading { display: flex; align-items: center; gap: 18px; margin: 90px 0 22px; }
  .section-heading h2 { margin: 0; font-size: 13px; font-weight: 600; letter-spacing: .01em; }
  .section-number { color: var(--coral); font-family: 'DM Mono', monospace; font-size: 11px; }
  .section-rule { height: 1px; flex: 1; background: var(--line); }
  .section-note { color: var(--muted); font-family: 'DM Mono', monospace; font-size: 10px; }

  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .project-card { display: flex; flex-direction: column; min-height: 310px; padding: 26px; background: var(--white); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 8px 24px rgba(23, 35, 56, .045); transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
  .project-card:hover { transform: translateY(-4px); border-color: #aebee8; box-shadow: 0 16px 34px rgba(23, 35, 56, .11); }
  .project-card.featured { grid-column: span 2; min-height: 280px; background: var(--ink); border-color: var(--ink); color: #fff; }
  .card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .card-index { color: #91a0b8; font-family: 'DM Mono', monospace; font-size: 11px; }
  .featured .card-index { color: #93a6d0; }
  .card-status { color: #2b966d; font-family: 'DM Mono', monospace; font-size: 10px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; }
  .featured .card-status { color: #8be2b7; }
  .project-card h3 { margin: 30px 0 10px; font-size: 27px; line-height: 1.1; letter-spacing: -.05em; }
  .featured h3 { max-width: 650px; color: #fff; font-size: clamp(30px, 4vw, 47px); }
  .project-card h3 span { color: var(--blue); }
  .featured h3 span { color: #a8b5ff; }
  .project-card p { max-width: 690px; margin: 0; color: var(--muted); font-size: 14px; line-height: 1.75; }
  .featured p { color: #b6c0d3; }
  .card-bottom { display: flex; align-items: end; justify-content: space-between; gap: 15px; margin-top: auto; padding-top: 24px; }
  .tech-list { display: flex; flex-wrap: wrap; gap: 6px; }
  .tech-list span { padding: 4px 8px; color: var(--blue-dark); background: #edf2ff; border-radius: 4px; font-family: 'DM Mono', monospace; font-size: 10px; }
  .featured .tech-list span { color: #c7d0ff; background: #2b385d; }
  .card-link { flex: none; color: var(--blue); font-family: 'DM Mono', monospace; font-size: 11px; font-weight: 500; }
  .featured .card-link { color: #ffd09c; }
  .card-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .card-icon { display: grid; place-items: center; width: 34px; height: 34px; color: var(--blue); background: var(--lavender); border-radius: 8px; font-family: 'DM Mono', monospace; font-size: 15px; }
  .featured .card-icon { color: #ffd09c; background: #2a3153; }

  .activity-card { display: grid; grid-template-columns: 220px 1fr; gap: 28px; align-items: center; padding: 24px 26px; background: var(--white); border: 1px solid var(--line); border-radius: 12px; }
  .activity-card h3 { margin: 7px 0 5px; font-size: 20px; letter-spacing: -.04em; }
  .activity-card p { margin: 0; color: var(--muted); font-size: 12px; }
  .activity-graph { min-width: 0; overflow: hidden; }
  .activity-graph img { display: block; width: 100%; max-width: 650px; height: auto; }
  .activity-caption { display: flex; justify-content: space-between; margin-top: 9px; color: var(--muted); font-family: 'DM Mono', monospace; font-size: 9px; }

  footer { display: flex; justify-content: space-between; padding: 22px 0 36px; border-top: 1px solid var(--line); color: var(--muted); font-family: 'DM Mono', monospace; font-size: 10px; }

  .prose { max-width: 780px; }
  .prose h1 { color: var(--ink); font-size: clamp(40px, 6vw, 64px); line-height: 1.05; letter-spacing: -.07em; }
  .prose h2 { margin-top: 44px; color: var(--blue-dark); font-size: 23px; }
  .prose p, .prose li { color: var(--muted); }
  .prose code { padding: 3px 6px; color: var(--blue-dark); background: #e8edff; border-radius: 4px; }
  .prose a { color: var(--blue-dark); text-decoration: underline; text-decoration-color: #9eafe8; text-underline-offset: 3px; }

  @media (max-width: 700px) {
    .site-shell { width: min(100% - 32px, 1120px); }
    .nav { height: 72px; }
    .nav-links { gap: 12px; }
    .nav-links a:nth-child(1), .nav-links a:nth-child(3) { display: none; }
    main { padding: 58px 0 78px; }
    .hero h1 { font-size: 48px; }
    .hero p { font-size: 16px; }
    .section-heading { margin-top: 65px; }
    .section-note { display: none; }
    .project-grid { grid-template-columns: 1fr; }
    .project-card.featured { grid-column: span 1; }
    .project-card { min-height: 290px; }
    .activity-card { grid-template-columns: 1fr; gap: 15px; }
    .activity-graph img { min-width: 560px; transform-origin: left top; transform: scale(.58); margin-bottom: -75px; }
    footer { flex-direction: column; gap: 7px; }
  }
</style>
