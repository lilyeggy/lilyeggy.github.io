---
const { title = "lilyeggy's web", description = 'Projects, progress, and notes by lilyeggy.' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      :root{font-family:"JetBrains Mono","SFMono-Regular",Consolas,monospace;color:#d7e0df;background:#080b10;line-height:1.7}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 80% 0%,#12342d 0,transparent 32%),#080b10}body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.035;background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:32px 32px}a{color:inherit;text-decoration:none}.wrap{max-width:1080px;margin:auto;padding:0 24px}nav{display:flex;justify-content:space-between;align-items:center;padding:28px 0;border-bottom:1px solid #1d292a}.logo{font-weight:800;color:#68f3b0;letter-spacing:-.06em}.logo:before{content:"~/";color:#63817a}.links{display:flex;gap:22px;color:#80938e;font-size:13px}.links a:hover{color:#68f3b0}main{padding:76px 0 100px}.eyebrow{color:#68f3b0;font-weight:700;font-size:12px;letter-spacing:.12em;text-transform:uppercase}.eyebrow:before{content:"// ";color:#406b5b}.hero{max-width:800px}.hero h1{font-size:clamp(42px,7vw,76px);line-height:1.05;letter-spacing:-.08em;margin:16px 0 22px;color:#f0f7f5}.hero h1:after{content:"_";color:#68f3b0;animation:blink 1s steps(2) infinite}@keyframes blink{50%{opacity:0}}.hero p{font-size:18px;color:#91a7a1;max-width:680px}.terminal-line{margin-top:34px;color:#61736e;font-size:12px}.terminal-line span{color:#68f3b0}.now{margin-top:8px;color:#c8d7d2;font-size:14px}.pulse{display:inline-block;width:8px;height:8px;background:#68f3b0;border-radius:50%;margin-right:10px;box-shadow:0 0 12px #68f3b0}.section-head{display:flex;align-items:center;gap:16px;margin-top:75px}.section-head .eyebrow{white-space:nowrap}.line{height:1px;background:#203134;flex:1}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;margin-top:58px}.card{background:#0d1318;border:1px solid #203134;border-radius:5px;padding:26px;box-shadow:0 0 0 1px #0a0d10,0 18px 50px #0005}.card:hover{border-color:#4acb91;transform:translateY(-3px);transition:.2s}.card h2{margin:8px 0 10px;font-size:20px;color:#edf8f4}.card p{color:#91a7a1;font-size:14px}.tag{display:inline-block;border:1px solid #286b51;border-radius:2px;padding:3px 8px;color:#68f3b0;font-size:11px;font-weight:700}.arrow{color:#68f3b0;font-weight:700;font-size:13px}.stack{display:flex;flex-wrap:wrap;gap:7px;margin:18px 0}.stack span{font-size:11px;color:#8ca49d;border:1px solid #293d3c;padding:2px 7px;border-radius:2px}.log-preview{border-left:2px solid #315747;padding-left:12px;color:#92a7a1;font-size:12px;margin:18px 0}.log-preview span{color:#68f3b0;margin-right:8px}.contributions{grid-column:1/-1}.contributions img{width:100%;margin-top:14px;filter:hue-rotate(85deg) saturate(1.5);background:#080b10}.stats{color:#91a7a1;font-size:12px}.stats b{color:#68f3b0}footer{border-top:1px solid #1d292a;color:#61736e;padding:24px 0 45px;font-size:12px}.prose{max-width:780px}.prose h1{font-size:48px;line-height:1.1;letter-spacing:-.06em;color:#f0f7f5}.prose h2{margin-top:42px;color:#68f3b0}.prose p,.prose li{color:#a0b3ad}.prose code{background:#14211f;color:#68f3b0;padding:2px 6px;border-radius:2px}.prose a{color:#68f3b0;text-decoration:underline}
      /* palette & card refinement */
      :root{color:#dce5f2;background:#0b1020}body{background:radial-gradient(circle at 85% 5%,#252653 0,transparent 30%),radial-gradient(circle at 10% 60%,#142d37 0,transparent 25%),#0b1020}body:before{opacity:.025}.logo{color:#f2c17d}.logo:before{color:#8d8be8}.links a:hover{color:#f2c17d}.eyebrow{color:#8d8be8}.eyebrow:before{color:#5960a6}.hero h1{color:#f4f1ea}.hero h1:after{color:#f2c17d}.hero p{color:#aab7ca}.terminal-line span,.arrow{color:#f2c17d}.now{color:#cbd5e3}.pulse{background:#f2c17d;box-shadow:0 0 12px #f2c17d}.section-head{margin-top:78px}.line{background:#26304b}.card{background:linear-gradient(145deg,#151c31,#101728);border:1px solid #2a3854;border-radius:14px;box-shadow:0 18px 60px #03061188}.card:hover{border-color:#8d8be8;box-shadow:0 18px 65px #030611cc}.card h2{color:#f4f1ea}.card p{color:#aab7ca}.tag{border:1px solid #4d4e80;color:#b8b5ff;background:#252648;border-radius:5px}.project-card{grid-column:span 2;min-height:300px;padding:32px;background:linear-gradient(135deg,#191d3c 0%,#111a2d 65%,#152b35 100%)}.project-card h2{font-size:clamp(30px,4vw,48px);line-height:1.05;letter-spacing:-.07em;margin:25px 0 15px}.project-card h2 em{font-style:normal;color:#b8b5ff}.project-top{display:flex;align-items:center;gap:14px}.project-icon{display:grid;place-items:center;width:38px;height:38px;border:1px solid #6a67b4;border-radius:9px;color:#f2c17d;font-size:22px}.stack span{border-color:#374966;color:#aab7ca}.log-preview{border-color:#5556a0;color:#aab7ca}.log-preview span{color:#f2c17d}.contributions{grid-column:span 2}.contributions img{filter:none;background:#0b1020;border-radius:8px;padding:10px}footer{border-color:#26304b;color:#71809a}.prose h1{color:#f4f1ea}.prose h2{color:#b8b5ff}.prose p,.prose li{color:#aab7ca}.prose code{background:#202743;color:#f2c17d}.prose a{color:#f2c17d}
      @media(max-width:700px){.project-card,.contributions{grid-column:span 1}.links{gap:10px}.links a:nth-child(1){display:none}.hero h1{font-size:48px}}
    </style>
  </head>
  <body><div class="wrap"><nav><a class="logo" href="/">lilyeggy's web</a><div class="links"><a href="/">首页</a><a href="/projects/vram-aware-harness">项目</a><a href="https://github.com/lilyeggy" target="_blank">GitHub ↗</a></div></nav><slot /><footer>© {new Date().getFullYear()} lilyeggy · 持续构建，持续记录。</footer></div></body>
</html>
