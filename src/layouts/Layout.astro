---
const { title = "lilyeggy's web", description = 'Projects, progress, and notes by lilyeggy.' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#172033;background:#f7f8fc;line-height:1.7}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}.wrap{max-width:1080px;margin:auto;padding:0 24px}nav{display:flex;justify-content:space-between;align-items:center;padding:24px 0}.logo{font-weight:800;letter-spacing:-.03em}.links{display:flex;gap:22px;color:#68738a;font-size:14px}.links a:hover{color:#172033}main{padding:54px 0 100px}.eyebrow{color:#6875e8;font-weight:700;font-size:13px;letter-spacing:.12em;text-transform:uppercase}.hero{max-width:760px}.hero h1{font-size:clamp(42px,7vw,76px);line-height:1.05;letter-spacing:-.06em;margin:16px 0 22px}.hero p{font-size:20px;color:#68738a}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-top:58px}.card{background:white;border:1px solid #e6e9f2;border-radius:20px;padding:28px;box-shadow:0 10px 35px #26345c0a}.card h2{margin:5px 0 10px;font-size:23px}.card p{color:#68738a}.tag{display:inline-block;border-radius:999px;padding:4px 10px;background:#eef0ff;color:#5966d7;font-size:12px;font-weight:700}.arrow{color:#5966d7;font-weight:700}footer{border-top:1px solid #e6e9f2;color:#8992a5;padding:24px 0 45px;font-size:14px}.prose{max-width:760px}.prose h1{font-size:48px;line-height:1.1;letter-spacing:-.04em}.prose h2{margin-top:42px}.prose p,.prose li{color:#536078}.prose code{background:#edf0f7;padding:2px 6px;border-radius:5px}.prose a{color:#5966d7;text-decoration:underline}
    </style>
  </head>
  <body><div class="wrap"><nav><a class="logo" href="/">lilyeggy's web</a><div class="links"><a href="/">首页</a><a href="/projects/vram-aware-harness">项目</a><a href="https://github.com/lilyeggy" target="_blank">GitHub ↗</a></div></nav><slot /><footer>© {new Date().getFullYear()} lilyeggy · 持续构建，持续记录。</footer></div></body>
</html>
